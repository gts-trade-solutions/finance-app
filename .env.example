# Copy to .env.local and fill in.
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CONNECTION_LIMIT=
DB_QUEUE_LIMIT=

# 32+ random bytes. Rotating this invalidates every active session.
SESSION_SECRET=
SESSION_TTL_HOURS=

APP_ENV=

# The canonical origin. Used by the metadata, the sitemap, robots.txt and the
# JSON-LD; leave it unset locally and it falls back to the production host.
NEXT_PUBLIC_SITE_URL=

# 32 bytes, as 64 hex characters. Seals the government portal credentials
# customers give us — their own GST API username and password. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without it every screen still works; only storing portal credentials fails,
# and the built-in stand-in provider needs no key at all.
INTEGRATION_KEY=

# NIC e-invoice API — the government's Invoice Registration Portal, called
# directly. Register at https://einv-apisandbox.nic.in as an ERP to get the
# client ID and secret, and download the public key from the same portal.
# With these unset, the built-in stand-in handles every submission.
#
# The public key: PEM text, bare base64, or a path to the downloaded file.
# The sandbox and production keys differ — the wrong one fails as unreadable
# credentials at the portal, not here.
NIC_EINV_CLIENT_ID=
NIC_EINV_CLIENT_SECRET=
NIC_EINV_PUBLIC_KEY=
# Leave unset for the sandbox. Set it only once production access has been
# granted, to the address that comes with that grant.
NIC_EINV_BASE_URL=
# Optional overrides, if NIC or a GSP mounts the API at different paths:
# NIC_EINV_AUTH_PATH=/eivital/v1.04/auth
# NIC_EINV_INVOICE_PATH=/eicore/v1.03/Invoice
# NIC_EINV_CANCEL_PATH=/eicore/v1.03/Invoice/Cancel
# NIC_EINV_EWB_PATH=/eiewb/v1.03/ewaybill

# ── AI assistant ─────────────────────────────────────────────────────────────
# OpenAI API key. Used on the server only; it never reaches the browser.
# Without it, a built-in stand-in answers in development, and in production the
# assistant says it is not set up.
OPENAI_API_KEY=
# Any Chat Completions model with tool calling. Default gpt-5-mini.
OPENAI_MODEL=
# For o-series and GPT-5 models: minimal | low | medium | high. Default low.
OPENAI_REASONING_EFFORT=
# Optional organisation / project headers, and a different base URL for a proxy.
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=
OPENAI_BASE_URL=
# Token prices in US$ per million, if the built-in table does not know the
# model or the published prices have changed. Credits are charged from these.
OPENAI_PRICE_INPUT=
OPENAI_PRICE_CACHED=
OPENAI_PRICE_OUTPUT=
# What one credit is worth in model cost, in US$. Default 0.003 — at the
# default model a typical question is 1–3 credits.
AI_CREDIT_COST_USD=
# Free credits when an organisation first turns the assistant on (default 50),
# the demo book's daily allowance (default 100), and the most a single question
# may reserve (default 20).
AI_TRIAL_CREDITS=
AI_DEMO_DAILY_CREDITS=
AI_MAX_CREDITS_PER_QUESTION=
# 1 allows the stand-in in production. Not recommended.
AI_STANDIN=

# ── Billing (Razorpay) ───────────────────────────────────────────────────────
# Razorpay dashboard → Account & Settings → API Keys. rzp_test_… keys take test
# payments; rzp_live_… keys take real money. Without keys: a built-in test
# checkout in development, and billing switched off in production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay dashboard → Webhooks. Point https://<your-host>/api/billing/webhook
# at: payment.authorized, payment.captured, payment.failed, order.paid,
# refund.processed, subscription.authenticated, subscription.activated,
# subscription.charged, subscription.pending, subscription.halted,
# subscription.cancelled, subscription.completed, subscription.paused,
# subscription.resumed, subscription.updated — and paste its secret here.
RAZORPAY_WEBHOOK_SECRET=
# The platform's own GST registration, printed on the tax invoice issued for
# every purchase of credits or a plan. Required before live payments are taken.
PLATFORM_LEGAL_NAME=
PLATFORM_GSTIN=
PLATFORM_ADDRESS=
PLATFORM_STATE_CODE=
PLATFORM_EMAIL=
# SAC code for the service — confirm with your chartered accountant. Default 998315.
PLATFORM_SAC=
# Prefix of the platform's invoice numbers, as in RKZ/26-27/00001. Default RKZ.
PLATFORM_INVOICE_PREFIX=
# GST on credits and plans, in percent. Default 18.
BILLING_GST_RATE=
