    "db:types": "node scripts/gen-db-types.mjs",
    "test:unit": "tsx --conditions=react-server --env-file=.env.local --test scripts/tests/money-sql.test.ts scripts/tests/posting.test.ts scripts/tests/purchases.test.ts scripts/tests/banking-reports.test.ts scripts/tests/sales-documents.test.ts scripts/tests/gst-integration.test.ts scripts/tests/nic-einvoice.test.ts scripts/tests/analytics.test.ts scripts/tests/ai-billing.test.ts scripts/tests/einvoice-cancel.test.ts scripts/tests/eway-bill-changes.test.ts scripts/tests/jobs.test.ts scripts/tests/ai-reports.test.ts scripts/tests/tally.test.ts scripts/tests/tally-connector.test.ts scripts/tests/tally-export.test.ts",
